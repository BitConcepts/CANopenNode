	range 48 256
	default 80

# Optional error-register conditions (enable default expressions in mapper)
config CANOPENNODE_ERR_CONDITION_CURRENT
	bool "Condition for calculating Error register: CURRENT"
	default n

config CANOPENNODE_ERR_CONDITION_VOLTAGE
	bool "Condition for calculating Error register: VOLTAGE"
